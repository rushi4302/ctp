APP_NAME="Civic Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Local development. Settings pin this connection to civic_db_test on localhost.
DATABASE_URL=postgresql+psycopg://civic_user:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/civic_db_test
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated values may be supplied as a JSON array in local .env.
CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000","http://localhost:5001","http://127.0.0.1:5001"]
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
